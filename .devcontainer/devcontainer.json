{
  "name": "Blog Astro (pnpm)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        // Soporte para Astro y formateo
        "astro-build.astro-vscode",
        "esbenp.prettier-vscode",

        // Redacción y corrección de Markdown
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish",

        // CMS visual para Frontmatter (opcional pero muy cómodo)
        "frontmatter.front-matter-cms"
      ],
      "settings": {
        // Envolver líneas automáticamente para que los párrafos no se vayan al infinito
        "[markdown]": {
          "editor.wordWrap": "on",
          "editor.quickSuggestions": false
        }
      }
    }
  },
  "forwardPorts": [4321]
}