{
  "name": "Blog Astro (pnpm)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "esbenp.prettier-vscode",
        "yzhang.markdown-all-in-one",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish",

        // 1. Extensión de Vim
        "vscodevim.vim",

        // 2. Extensión de tema (ej: Tokyo Night, One Dark Pro, Catppuccin, etc.)
      ],
      "settings": {
        // --- APARIENCIA ---
        "editor.fontSize": 16,
        "editor.lineHeight": 24,

        // --- CONFIGURACIÓN DE VIM ---
        "vim.useSystemClipboard": true,       // Para que 'y' y 'p' usen el portapapeles de tu PC
        "vim.hlsearch": true,                 // Resaltar búsquedas
        "vim.incsearch": true,
        "vim.easymotion": true,

        "vim.insertModeKeyBindings": [
          {
            "before": ["j", "j"],
            "after": ["<Esc>"]
          }
        ],

        // --- REDACCIÓN ---
        "[markdown]": {
          "editor.wordWrap": "on"
        }
      }
    }
  },
  "forwardPorts": [4321]
}